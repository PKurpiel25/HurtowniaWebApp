@using HurtowniaWebClient.Models.Zapytania;
@model IEnumerable<ZapytanieSingle>

@{
    ViewData["Title"] = "Lista zapytań";
}

<div>
    <h2>Zapytania</h2>
    <table class="table table-sm table-striped table-bordered m-2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nazwa</th>
                <th>Klient</th>
                <th>Produkt</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        <form asp-action="GetZapytanie" method="post">
                            <input type="hidden" class="form-control" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.Id</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="GetZapytanie" method="post">
                            <input type="hidden" class="form-control" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.Tytuł</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="GetZapytanie" method="post">
                            <input type="hidden" class="form-control" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.KlientEmail</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="GetZapytanie" method="post">
                            <input type="hidden" class="form-control" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.ProduktNazwa</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>