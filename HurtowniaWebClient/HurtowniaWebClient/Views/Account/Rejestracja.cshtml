@using HurtowniaWebClient.Models.Konto;
@model Rejestracja
@{
    ViewData["Title"] = "Rejestracja";
}

<a asp-controller="Home" asp-action="Index" class="btn btn-sm btn-secondary">Wróć</a>
<br>
<br>
<h1>Rejestracja</h1>
<div asp-validation-summary="All" class="text-danger"></div>

<form method="post">
    <input type="hidden" asp-for="Id" />
    <div class="form-group">
        <label asp-for="Login">Login:</label>
        <input asp-for="Login" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="Email">Email:</label>
        <input asp-for="Email" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="Hasło">Hasło:</label>
        <input asp-for="Hasło" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="PotwHasło">Potwierdź hasło:</label>
        <input asp-for="PotwHasło" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="Imię">Imię:</label>
        <input asp-for="Imię" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="Nazwisko">Nazwisko:</label>
        <input asp-for="Nazwisko" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="Firma">Firma:</label>
        <input asp-for="Firma" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="NumerTel">Numer telefonu:</label>
        <input asp-for="NumerTel" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="PESEL">PESEL:</label>
        <input asp-for="PESEL" class="form-control" />
    </div>
    <br>
    <div class="form-group">
        <label asp-for="Polityka">Zapoznałem się i akceptuje <a asp-controller="Home" asp-action="Privacy">politykę prywatności</a></label>
        <input asp-for="Polityka" required />
    </div>
    <br>
    <button type="submit" class="btn btn-sm btn-primary">Utwórz konto</button>
</form>