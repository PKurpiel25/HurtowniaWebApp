@using HurtowniaWebClient.Models.Produkty;
@model IEnumerable<Produkt>

@{
    ViewData["Title"] = "Lista produktów";
}

<div>
    <h2>Produkty</h2>
    <a asp-action="AddProdukt" class="btn btn-sm btn-primary">Dodaj nowy produkt</a>
    <table class="table table-sm table-striped table-bordered m-2">
        <thead>
            <tr>
                <th>ID</th>
                <th>Nazwa</th>
                <th>Cena</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td><a class="łącze" asp-action="UpdateProdukt" asp-route-id="@r.Id">@r.Id</a></td>
                    <td><a class="łącze" asp-action="UpdateProdukt" asp-route-id="@r.Id">@r.Nazwa</a></td>
                    <td><a class="łącze" asp-action="UpdateProdukt" asp-route-id="@r.Id">@r.Cena.ToString().Remove(@r.Cena.ToString().Length-2,2).Insert(@r.Cena.ToString().Length-2,"zł")</a></td>
                </tr>
            }
        </tbody>
    </table>
</div>