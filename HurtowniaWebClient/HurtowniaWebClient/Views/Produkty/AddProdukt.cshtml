@using HurtowniaWebClient.Models.Produkty;
@using HurtowniaWebClient.Models;
@model ProduktFile
@{
    ViewBag.Title = "Dodaj nowy produkt";
}

<a asp-action="Produkty" class="btn btn-sm btn-secondary">Wróć</a>
<br>
<br>
<div>
    <h2>Dodaj produkt</h2>
    <form asp-action="AddProdukt" enctype="multipart/form-data" method="post">
        <input type="hidden" asp-for="Zdjęcia" multiple />
        <div class="form-group">
            <label asp-for="Nazwa">Nazwa:</label>
            <input class="form-control" asp-for="Nazwa" />
        </div>
        <br>
        <div class="form-group">
            <label asp-for="Opis">Opis:</label>
            <textarea class="form-control" asp-for="Opis" rows="10"></textarea>
        </div>
        <br>
        <div class="form-group">
            <label asp-for="Cena">Cena:</label>
            <input class="form-control" asp-for="Cena" />
        </div>
        <br>
        <div class="form-group">
            <label asp-for="VAT">VAT:</label>
            <input class="form-control" asp-for="VAT" />
        </div>
        <br>
        <div class="form-group">
            <label asp-for="Ilość">Ilość:</label>
            <input class="form-control" asp-for="Ilość" />
        </div>
        <br>
        <div class="form-group">
            <label asp-for="Pliki" >Wybierz zdjęcia (PNG, JPG):</label>
            <br>
            <input class="form-control" asp-for="Pliki" accept=".jpg, .jpeg, .png" multiple />
        </div>
        <br>
        <input type="submit" class="btn btn-sm btn-primary" value="Zapisz" />
    </form>
</div>