@using HurtowniaWebClient.Models.Produkty;
@model IEnumerable<Produkt>

@{
    ViewData["Title"] = "Lista produktów";
}

<div>
    <h2>Produkty</h2>
    <table class="table table-sm table-striped table-bordered m-2">
        <thead>
            <tr>
                <th>Nazwa</th>
                <th>Cena</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        <form asp-action="GetProdukt" method="post">
                            <input type="hidden" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.Nazwa</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="GetProdukt" method="post">
                            <input type="hidden" class="form-control" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.Cena.ToString().Remove(@r.Cena.ToString().Length-2,2).Insert(@r.Cena.ToString().Length-2,"zł")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>