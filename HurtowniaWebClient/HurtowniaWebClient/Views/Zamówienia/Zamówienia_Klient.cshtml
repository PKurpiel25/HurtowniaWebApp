@using HurtowniaWebClient.Models.Zamówienia;
@model IEnumerable<ZamówienieSingleKlient>

@{
    ViewData["Title"] = "Lista zamówień";
}

<div>
    <h2>Zamówienia</h2>
    <table class="table table-sm table-striped table-bordered m-2">
        <thead>
            <tr>
                <th>Rodzaj przesyłki</th>
                <th>Rodzaj płatności</th>
                <th>Koszt</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var r in Model)
            {
                <tr>
                    <td>
                        <form asp-action="GetZamówienie_Klient" method="post">
                            <input type="hidden" class="form-control" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.RodzajPrzesyłkiNazwa</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="GetZamówienie_Klient" method="post">
                            <input type="hidden" class="form-control" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.RodzajPłatnościNazwa</button>
                        </form>
                    </td>
                    <td>
                        <form asp-action="GetZamówienie_Klient" method="post">
                            <input type="hidden" class="form-control" name="id" value="@r.Id" />
                            <button class="przycisk" type="submit">@r.Koszt.ToString().Insert(r.Koszt.ToString().Length,"zł")</button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>